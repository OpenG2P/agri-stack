# Composite API base (the agri-composite-api service); admin calls go to <BACKEND_URL>/composite/v1/admin/*
BACKEND_URL="http://agri-composite-api"
DEFAULT_LOCALE="en"

IAM_URL="https://iam.example.openg2p.org"
LOGIN_PROVIDER_ID="1"
APPLICATION_MNEMONIC="agri-composite"
COOKIE_DOMAIN=".example.openg2p.org"
