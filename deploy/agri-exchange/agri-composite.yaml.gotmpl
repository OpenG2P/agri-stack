# Agri Exchange override for openg2p-agri-composite (release `agri-composite`).
# Consent mode "exchange": the composite validates each partner consent at the
# exchange Consent Manager (commons-services), which issues one signed receipt
# per department registry; each registry gets its own receipt.
{{- if .Values.baseDomain }}
global:
  compositeHostname: {{ printf "agri-composite.%s" .Values.baseDomain | quote }}
  consoleHostname: {{ printf "agri-composite-console.%s" .Values.baseDomain | quote }}
  staffIamHostname: {{ printf "staff-iam.%s" .Values.baseDomain | quote }}
  consoleCookieDomain: {{ printf ".%s" .Values.baseDomain | quote }}
{{- end }}

# The staff console (on by default). Its IAM registration runs as a regular Job,
# not a Helm hook (as commons does for Master Data): helmfile/Rancher installs
# may skip hooks, and one failing hook stops the rest.
console:
  iamRegister:
    runAsHook: false
{{- if .Values.baseDomain }}
  # Portal links shown in the console, on the same base domain.
  pmPortalUrl: {{ printf "https://partner-management.%s" .Values.baseDomain | quote }}
  cmPortalUrl: {{ printf "https://consent-manager.%s" .Values.baseDomain | quote }}
{{- end }}

composite:
  # The Consent Manager's partner portal reads the public use-case list from the browser.
  corsAllowOrigins: {{ printf "https://consent-partner-portal.%s" (.Values.baseDomain | default (printf "%s.openg2p.org" .Values.namespace)) | quote }}
  # Department registries (data controller ID → partner DCI sync search URL).
  registries:
{{- range $name, $url := .Values.registries }}
    {{ $name }}:
      url: {{ $url | quote }}
{{- end }}
  consent:
    mode: exchange
    exchangeCmUrl: {{ .Values.exchangeCmUrl | default "http://commons-services-cm-partner-api" | quote }}
